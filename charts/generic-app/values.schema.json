{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "generic-app values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "description": "String to partially override common.names.fullname",
      "type": "string"
    },
    "fullnameOverride": {
      "description": "String to fully override common.names.fullname",
      "type": "string"
    },
    "namespaceOverride": {
      "description": "String to fully override common.names.namespace",
      "type": "string"
    },
    "commonLabels": {
      "description": "Labels to add to all deployed objects",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "description": "Annotations to add to all deployed objects",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "replicaCount": {
      "description": "Number of replicas to deploy",
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "description": "Workload kind (Deployment, StatefulSet, or DaemonSet)",
      "enum": [
        "Deployment",
        "StatefulSet",
        "DaemonSet"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "description": "Application image registry (empty uses the runtime default, normally docker.io)",
          "type": "string"
        },
        "repository": {
          "description": "Application image repository (REQUIRED)",
          "type": "string"
        },
        "tag": {
          "description": "Application image tag (immutable tags are recommended)",
          "type": [
            "string",
            "integer"
          ]
        },
        "digest": {
          "description": "Application image digest, e.g. sha256:abc... (pins the image; may be combined with tag)",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Application image pull policy",
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "description": "Application image pull secrets",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository"
      ]
    },
    "command": {
      "description": "Override default container command (useful when using custom images)",
      "type": [
        "array",
        "string"
      ]
    },
    "args": {
      "description": "Override default container args (useful when using custom images)",
      "type": [
        "array",
        "string"
      ]
    },
    "containerPorts": {
      "description": "Container ports map (name -> number), independent of service.ports; falls back to service.ports when empty and service.enabled is true",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "extraEnvVars": {
      "description": "Array with extra environment variables to add",
      "type": [
        "array",
        "string"
      ]
    },
    "extraEnvVarsConfigMaps": {
      "description": "List of existing ConfigMaps to load as environment variables",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnvVarsSecrets": {
      "description": "List of existing Secrets to load as environment variables",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "nodePorts": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "enum": [
                  "",
                  null
                ]
              }
            ]
          }
        },
        "clusterIP": {
          "type": "string"
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "Cluster",
            "Local"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraPorts": {
          "type": [
            "array",
            "string"
          ]
        },
        "sessionAffinity": {
          "enum": [
            "",
            "None",
            "ClientIP"
          ]
        },
        "sessionAffinityConfig": {
          "type": "object"
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuerType": {
          "enum": [
            "Issuer",
            "ClusterIssuer"
          ]
        },
        "issuerName": {
          "type": "string"
        },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "server": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "privateKeySecretRef": {
              "type": "string"
            },
            "solvers": {
              "type": "array"
            }
          }
        },
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "server": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "caBundle": {
              "type": "string"
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tokenSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressClassName": {
          "type": "string"
        },
        "pathType": {
          "enum": [
            "Exact",
            "Prefix",
            "ImplementationSpecific"
          ]
        },
        "hostname": {
          "type": "string"
        },
        "servicePort": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "boolean"
        },
        "extraHosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "pathType": {
                "enum": [
                  "Exact",
                  "Prefix",
                  "ImplementationSpecific"
                ]
              }
            }
          }
        },
        "extraPaths": {
          "type": [
            "array",
            "string"
          ]
        },
        "extraTls": {
          "type": [
            "array",
            "string"
          ]
        },
        "extraRules": {
          "type": [
            "array",
            "string"
          ]
        }
      }
    },
    "gatewayApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "PathPrefix",
                    "Exact",
                    "RegularExpression"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "servicePort": {
              "type": "string"
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request": {
                  "type": "string"
                },
                "backendRequest": {
                  "type": "string"
                }
              }
            },
            "rules": {
              "type": [
                "array",
                "string"
              ]
            },
            "extraRules": {
              "type": [
                "array",
                "string"
              ]
            }
          }
        },
        "httpRedirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "PathPrefix",
                    "Exact",
                    "RegularExpression"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "scheme": {
              "enum": [
                "http",
                "https"
              ]
            },
            "statusCode": {
              "enum": [
                301,
                302
              ]
            }
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "secretName": {
              "type": "string"
            },
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "group": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          }
        },
        "nginxGatewayFabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clientSettings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bodyMaxSize": {
                  "type": "string"
                }
              }
            },
            "upstreamProxyTimeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "connect": {
                  "type": "string"
                },
                "read": {
                  "type": "string"
                },
                "send": {
                  "type": "string"
                }
              }
            },
            "snippets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extra": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "context",
                      "value"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "context": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "description": "Container resource requests and limits (empty: none set)",
      "type": "object"
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "customLivenessProbe": {
      "description": "Custom livenessProbe that overrides the default one",
      "type": [
        "object",
        "string"
      ]
    },
    "customReadinessProbe": {
      "description": "Custom readinessProbe that overrides the default one",
      "type": [
        "object",
        "string"
      ]
    },
    "customStartupProbe": {
      "description": "Custom startupProbe that overrides the default one",
      "type": [
        "object",
        "string"
      ]
    },
    "lifecycleHooks": {
      "description": "for the container(s) to automate configuration before or after startup",
      "type": [
        "object",
        "string"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        },
        "selector": {
          "type": "object"
        },
        "dataSource": {
          "type": "object"
        },
        "mountPath": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "resourcePolicy": {
          "enum": [
            "",
            "keep"
          ]
        },
        "persistentVolumeClaimRetentionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whenDeleted": {
              "enum": [
                "Retain",
                "Delete"
              ]
            },
            "whenScaled": {
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          }
        },
        "extraVolumeClaimTemplates": {
          "type": [
            "array",
            "string"
          ]
        }
      }
    },
    "initContainers": {
      "description": "Add additional init containers to the pods",
      "type": [
        "array",
        "string"
      ]
    },
    "sidecars": {
      "description": "Add additional sidecar containers to the pods",
      "type": [
        "array",
        "string"
      ]
    },
    "extraVolumes": {
      "description": "Optionally specify extra list of additional volumes for the pods",
      "type": [
        "array",
        "string"
      ]
    },
    "extraVolumeMounts": {
      "description": "Optionally specify extra list of additional volumeMounts for the container(s)",
      "type": [
        "array",
        "string"
      ]
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "creationPolicy": {
              "enum": [
                "Owner",
                "Orphan",
                "Merge",
                "None"
              ]
            },
            "deletionPolicy": {
              "enum": [
                "Retain",
                "Delete",
                "Merge"
              ]
            },
            "template": {
              "type": "object"
            }
          }
        },
        "data": {
          "type": [
            "array",
            "string"
          ]
        },
        "dataFrom": {
          "type": [
            "array",
            "string"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rules": {
          "type": [
            "array",
            "string"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPU": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "targetMemory": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "extraIngress": {
          "type": [
            "array",
            "string"
          ]
        },
        "extraEgress": {
          "type": [
            "array",
            "string"
          ]
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "honorLabels": {
          "type": "boolean"
        },
        "jobLabel": {
          "type": "string"
        },
        "relabelings": {
          "type": "array"
        },
        "scheme": {
          "enum": [
            "",
            "http",
            "https"
          ]
        },
        "metricRelabelings": {
          "type": "array"
        }
      }
    },
    "podLabels": {
      "description": "Extra labels for pods",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "description": "Annotations for pods",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAffinityPreset": {
      "description": "Pod affinity preset. Ignored if `affinity` is set. Allowed values: `soft` or `hard`",
      "enum": [
        "",
        "soft",
        "hard"
      ]
    },
    "podAntiAffinityPreset": {
      "description": "Pod anti-affinity preset. Ignored if `affinity` is set. Allowed values: `soft` or `hard`",
      "enum": [
        "",
        "soft",
        "hard"
      ]
    },
